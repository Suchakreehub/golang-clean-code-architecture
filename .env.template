# Application Settings
APP_NAME=Khaojai Clean Architecture API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL by default, auto-fallback to SQLite in dev)
DB_TYPE=sqlite
DATABASE_URL=sqlite:///./khaojai.db

# PostgreSQL Settings (for Docker or production)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=golang-first-api
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security & JWT Tokens
SECRET_KEY=khaojai-super-secret-jwt-key-2026-clean-architecture
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES=86400
JWT_REFRESH_EXPIRES=172800

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
